      "parameters": {
        "jsCode": "const ragItems = $input.all();\nconst ragLines = ragItems.map(function(item) {\n  return \"- [\" + item.json.property_categoria + \"] \" + item.json.property_contenido;\n});\nconst ragContext = ragLines.join(\"\\n\");\nconst ideaSemilla = $('Notion Trigger').first().json.Idea_Semilla;\nconst pageId = $('Notion Trigger').first().json.id;\nconst promptText = \"Sos el redactor de contenido de Kolibri CRM, un software de gestion de clientes para pymes y freelancers en Latinoamerica.\\n\\n\" +\n\"(150-220 palabras), en tono cercano y profesional, basado en la siguiente idea semilla:\\n\" +\n\"'\" + ideaSemilla + \"'\\n\\n\" +\n\"Usa UNICAMENTE la siguiente informacion de contexto privado sobre Kolibri CRM como base factual del post (no inventes datos, features ni cifras que no esten aqui):\\n\" +\nragContext + \"\\n\\n\" +\n\"Antes de escribir, pensa paso a paso (no lo muestres en la respuesta):\\n\" +\n\"1. Elegi que datos de contexto son mas relevantes para la idea semilla.\\n\" +\n\"2. Defini un gancho inicial que capture atencion en las primeras 2 lineas.\\n\" +\n\"3. Estructura el post: hook, problema, solucion con dato de contexto, cierre con pregunta o CTA suave.\\n\" +\n\"Devolve UNICAMENTE el texto final del post de LinkedIn, sin explicaciones ni el razonamiento intermedio.\";\n\nreturn [{ json: { idea_semilla: ideaSemilla, rag_context: ragContext, prompt_text: promptText, page_id: pageId } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
